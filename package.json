{
  "name": "meatdeck",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "MeatDeck: the meat proxy's daily deck, driven by Claude Code",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShalomSagi/MeatDeck.git"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"node --watch server/index.ts\" \"vite\"",
    "build": "vite build && node scripts/build-desktop.mjs",
    "start": "node server/index.ts",
    "desktop": "pnpm build && electron .",
    "package": "pnpm build && electron-builder --mac dir --arm64",
    "mcp": "node mcp/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "knip": "knip",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "emojibase-data": "^17.0.0",
    "esbuild": "^0.28.2",
    "frimousse": "0.3.0",
    "hono": "^4.13.13",
    "knip": "6.39.0",
    "lucide-react": "^1.54.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.2",
  "build": {
    "appId": "is.sag.meatdeck",
    "productName": "MeatDeck (Alpha)",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "skill/**/*",
      "package.json"
    ],
    "asar": false,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        "dir"
      ],
      "darkModeSupport": true
    },
    "electronDist": "node_modules/electron/dist"
  },
  "meatdeck": {
    "updates": {
      "github": "ShalomSagi/MeatDeck"
    }
  },
  "productName": "MeatDeck (Alpha)"
}
